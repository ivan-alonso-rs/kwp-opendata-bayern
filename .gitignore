# --- secrets: never commit ---
.env
*.pgpass

# --- data: downloaded or generated locally, never committed ---
data/raw/*
data/interim/*
data/processed/*
!data/*/.gitkeep
# local copies of reference documents (published heat plans etc.)
references/

# --- large / generated outputs ---
*.gpkg-journal
*.gpkg-wal
*.gpkg-shm
outputs/tmp/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# --- QGIS ---
*.qgs~
*.qgz~
.qgis*/

# --- editors / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store
